.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshot baselines used for visual regression checks — never committed
.baseline/

# unrelated personal files found sitting in this folder — not part of the
# website, excluded so they don't get swept into a public commit by mistake
heart_popup.py
__pycache__/
*.pyc
